# Xのログインセッションが入っている。公開すると誰でもこのアカウントに入れてしまうので、
# 絶対にコミットしないこと。
chrome_profile/

# 画面に入力した内容（アカウント名・ローカルのフォルダパス）を覚えているだけのファイル
settings.json

__pycache__/
*.pyc

# 個人的なメモ（実アカウント名・実パス入り）。アプリ本体ではないので配布しない。
ターミナル.txt

# PyInstallerのビルド成果物。exeは数十MBあるのでリポジトリに入れず、
# 配布時はGitHub Releasesにアップロードする。
build/
dist/
*.spec
